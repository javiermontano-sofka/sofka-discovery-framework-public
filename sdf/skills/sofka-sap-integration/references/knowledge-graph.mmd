graph TB
    subgraph Patterns["Integration Patterns"]
        P1[Synchronous<br/>Request-Reply]
        P2[Asynchronous<br/>Fire-and-Forget]
        P3[Batch<br/>Scheduled Transfer]
        P4[Event-Driven<br/>Fan-Out]
    end

    subgraph CPI["SAP Integration Suite"]
        C1[iFlow Engine<br/>Message Processing]
        C2[API Management<br/>Gateway + Policies]
        C3[Event Mesh<br/>AMQP Topics]
        C4[Integration Advisor<br/>AI Mapping]
    end

    subgraph APIs["API Protocols"]
        A1[OData V4<br/>RAP Services]
        A2[OData V2<br/>Standard APIs]
        A3[REST/JSON<br/>External]
        A4[CATS BAPI<br/>Timesheet]
    end

    subgraph ErrorHandling["Error Strategy"]
        E1[Transient<br/>Retry + Backoff]
        E2[Data<br/>DLQ + Alert]
        E3[Auth<br/>Credential Refresh]
        E4[Business<br/>User Notification]
        E5[System<br/>Circuit Breaker]
    end

    subgraph Monitoring["Monitoring"]
        M1[CPI Dashboard]
        M2[Cloud ALM]
        M3[Alert Rules]
    end

    P1 --> C1
    P2 --> C3
    P3 --> C1
    P4 --> C3

    C1 --> A1
    C1 --> A2
    C1 --> A3
    C1 --> A4

    C1 --> E1
    C1 --> E2
    C1 --> E3
    C1 --> E4
    C1 --> E5

    E1 --> M1
    E2 --> M2
    E5 --> M3

    classDef pattern fill:#FFD700,color:#1A1A2E
    classDef cpi fill:#FF7E08,color:white
    classDef api fill:#EFEAE4,color:#1A1A2E
    classDef error fill:#1A1A2E,color:white
    classDef monitor fill:#FF7E08,color:white

    class P1,P2,P3,P4 pattern
    class C1,C2,C3,C4 cpi
    class A1,A2,A3,A4 api
    class E1,E2,E3,E4,E5 error
    class M1,M2,M3 monitor
