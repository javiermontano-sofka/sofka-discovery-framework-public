graph TB
    subgraph Inputs["Workshop Inputs"]
        I1[AS-IS Process Documentation]
        I2[SAP Best Practices Flows]
        I3[Scope Item Selection]
        I4[Stakeholder List]
    end

    subgraph Workshop["Workshop Protocol"]
        W1[Step 1: Present SAP Standard<br/>30 min]
        W2[Step 2: Compare AS-IS<br/>60 min]
        W3[Step 3: Score Gaps<br/>30 min]
        W4[Step 4: Validate & Prioritize<br/>30 min]
    end

    subgraph Scoring["Gap Scoring"]
        S1[Effort<br/>1-3]
        S2[Risk<br/>1-3]
        S3[Upgrade Impact<br/>1-3]
        S4[Business Value<br/>1-3]
        SF[Gap Score = E+R+U]
    end

    subgraph Classification["Gap Classification"]
        C1[Fit<br/>Score 0]
        C2[Configure<br/>Score 1-4]
        C3[Extend-KU<br/>Score 5-6]
        C4[Extend-RAP<br/>Score 7-8]
        C5[Extend-BTP<br/>Score 9-10]
        C6[Custom AVOID<br/>Score 11-12]
    end

    subgraph Outputs["Workshop Outputs"]
        O1[Process Coverage Matrix]
        O2[Gap Detail Cards]
        O3[Blocking Gaps List]
        O4[Dependency Map]
    end

    subgraph Consumers["Downstream"]
        D1[sofka-sap-gap-analysis]
        D2[sofka-sap-solution-design]
    end

    I1 --> W2
    I2 --> W1
    I3 --> W1
    I4 --> W2

    W1 --> W2 --> W3 --> W4

    S1 --> SF
    S2 --> SF
    S3 --> SF

    W3 --> SF
    SF --> C1
    SF --> C2
    SF --> C3
    SF --> C4
    SF --> C5
    SF --> C6

    W4 --> O1
    W4 --> O2
    W4 --> O3
    W4 --> O4

    O2 --> D1
    O3 --> D1
    O4 --> D2

    classDef input fill:#FFD700,color:#1A1A2E,stroke:#FF7E08
    classDef workshop fill:#FF7E08,color:white,stroke:#1A1A2E
    classDef scoring fill:#EFEAE4,color:#1A1A2E,stroke:#FF7E08
    classDef class fill:#1A1A2E,color:white,stroke:#FF7E08
    classDef output fill:#1A1A2E,color:white,stroke:#FFD700
    classDef consumer fill:#FFD700,color:#1A1A2E,stroke:#1A1A2E

    class I1,I2,I3,I4 input
    class W1,W2,W3,W4 workshop
    class S1,S2,S3,S4,SF scoring
    class C1,C2,C3,C4,C5,C6 class
    class O1,O2,O3,O4 output
    class D1,D2 consumer
