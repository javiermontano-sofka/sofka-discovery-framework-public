graph TB
    subgraph Inputs["From Fit-to-Standard"]
        I1[Gap List per Module]
        I2[Gap Scores<br/>Effort+Risk+Upgrade]
        I3[Business Value Scores]
    end

    subgraph Analysis["Gap Analysis Process"]
        A1[Consolidate<br/>Cross-Module Register]
        A2[Classify<br/>7-Class Taxonomy]
        A3[Map Dependencies<br/>Prerequisite/Enables/Shares]
        A4[Identify Blocking<br/>Critical Path]
        A5[Prioritize<br/>Wave Assignment]
    end

    subgraph ABCD["Clean Core Levels"]
        L1[Level A<br/>Released APIs Only]
        L2[Level B<br/>Classic APIs]
        L3[Level C<br/>Internal Objects]
        L4[Level D<br/>FORBIDDEN]
    end

    subgraph ADR["Architecture Decisions"]
        D1[ADR Template<br/>6-Part Standard]
        D2[Decision Options<br/>Min 2 Alternatives]
        D3[SDA Approval<br/>5-Day Time-Box]
    end

    subgraph Outputs["Deliverables"]
        O1[Gap Register<br/>Prioritized]
        O2[Dependency Graph<br/>Mermaid]
        O3[ADR Collection]
        O4[Wave Plan]
    end

    subgraph Consumers["Downstream"]
        C1[sofka-sap-solution-design]
        C2[sofka-sap-btp-extensibility]
        C3[sofka-sap-data-migration]
    end

    I1 --> A1
    I2 --> A2
    I3 --> A5
    A1 --> A2 --> A3 --> A4 --> A5

    A2 --> L1
    A2 --> L2
    A2 --> L3
    A2 -.->|NEVER| L4

    A4 --> D1
    D1 --> D2 --> D3

    A5 --> O1
    A3 --> O2
    D3 --> O3
    A5 --> O4

    O1 --> C1
    O3 --> C1
    O1 --> C2
    O4 --> C3

    classDef input fill:#FFD700,color:#1A1A2E
    classDef analysis fill:#FF7E08,color:white
    classDef level fill:#EFEAE4,color:#1A1A2E
    classDef forbidden fill:#FF0000,color:white
    classDef adr fill:#1A1A2E,color:white
    classDef output fill:#1A1A2E,color:#FFD700
    classDef consumer fill:#FFD700,color:#1A1A2E

    class I1,I2,I3 input
    class A1,A2,A3,A4,A5 analysis
    class L1,L2,L3 level
    class L4 forbidden
    class D1,D2,D3 adr
    class O1,O2,O3,O4 output
    class C1,C2,C3 consumer
