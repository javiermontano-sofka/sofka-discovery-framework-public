graph TB
    subgraph Decision["Extension Decision"]
        D1{Standard?}
        D2{Key User?}
        D3{ABAP Cloud?}
        D4{BTP?}
        D5[Process Redesign]
    end

    subgraph OnStack["On-Stack Extensions"]
        KU[Key User<br/>Custom Fields, Logic, CDS]
        RAP[ABAP Cloud RAP<br/>Business Objects, OData V4]
        ATC[ATC Governance<br/>Clean Core Checks]
    end

    subgraph SideBySide["BTP Side-by-Side"]
        CAP[CAP Framework<br/>Node.js / Java]
        BUILD[SAP Build<br/>Apps + Process Auto + Work Zone]
        IS[Integration Suite<br/>CPI + API Mgmt]
        EM[Event Mesh<br/>Async Events]
    end

    subgraph Infra["BTP Infrastructure"]
        DEV[Subaccount: DEV]
        QAS[Subaccount: QAS]
        PRD[Subaccount: PRD]
        SAND[Subaccount: SANDBOX]
    end

    subgraph Connect["Connectivity"]
        DEST[Destination Service]
        COMM[Communication Arrangement]
        CC[Cloud Connector<br/>On-Premise]
    end

    D1 -->|No| D2
    D2 -->|Yes| KU
    D2 -->|No| D3
    D3 -->|Yes| RAP
    D3 -->|No| D4
    D4 -->|Yes| CAP
    D4 -->|Yes| BUILD
    D4 -->|No| D5

    KU --> ATC
    RAP --> ATC

    CAP --> DEV
    CAP --> QAS
    CAP --> PRD
    BUILD --> DEV

    IS --> DEST
    EM --> DEST
    DEST --> COMM
    DEST --> CC

    classDef decision fill:#EFEAE4,color:#1A1A2E
    classDef onstack fill:#FF7E08,color:white
    classDef btp fill:#FFD700,color:#1A1A2E
    classDef infra fill:#1A1A2E,color:white
    classDef connect fill:#EFEAE4,color:#1A1A2E,stroke:#FF7E08

    class D1,D2,D3,D4,D5 decision
    class KU,RAP,ATC onstack
    class CAP,BUILD,IS,EM btp
    class DEV,QAS,PRD,SAND infra
    class DEST,COMM,CC connect
