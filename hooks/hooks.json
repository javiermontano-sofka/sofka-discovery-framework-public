{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/scan-deliverables.sh\" \"$PWD\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/session-context-gen.sh\" \"$PWD\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/auto-prime-check.sh\" \"$PWD\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/ghost-menu-inject.sh\" \"$PWD\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/session-changelog.sh\" \"$PWD\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/session-changelog.sh\" \"$PWD\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_DIR/scripts/post-prime-calibrate.sh\" \"$PWD\" 2>/dev/null || true"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
